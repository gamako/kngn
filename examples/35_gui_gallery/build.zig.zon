.{
    .name = .example_35_gui_gallery,
    .version = "0.0.0",
    .fingerprint = 0x4016df7eb0f6be17,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The kngn package root is two directories up. A copy of this sample placed next to a
        // kngn checkout changes this path and nothing else.
        .kngn = .{
            .path = "../..",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "sample.zon",
        "e2e.txt",
        "e2e.sh",
    },
}
