#!/usr/bin/env bash
# drive: thin entry for the headless harness live driver.
# exec the built zig-out/bin/drive directly (no per-call zig build = keep response stdout clean).
#
#   scripts/drive --port-file /tmp/vp.port 'inject key_down A; step 3; digest fb'
#
# Build zig-out/bin/drive first with `zig build drive` (or `zig build`).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$here/zig-out/bin/drive"
if [[ ! -x "$bin" ]]; then
  echo "drive: $bin not found. Build first with 'zig build drive' (or zig build)." >&2
  exit 1
fi
exec "$bin" "$@"
