#!/usr/bin/env bash
# vp-mcp: thin entry for harness live TCP ↔ stdio MCP.
# exec the built zig-out/bin/vp-mcp directly (no per-call zig build = keep stdout clean).
#
#   scripts/mcp --port-file /tmp/vp.port
#
# Build zig-out/bin/vp-mcp first with `zig build mcp` (or `zig build`).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$here/zig-out/bin/vp-mcp"
if [[ ! -x "$bin" ]]; then
  echo "vp-mcp: $bin not found. Build first with 'zig build mcp' (or zig build)." >&2
  exit 1
fi
exec "$bin" "$@"
